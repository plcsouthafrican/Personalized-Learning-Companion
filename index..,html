 {title:'Fractions made easy',emoji:'🍕',subject:'Maths',slides:[['🍕','Fractions are parts of one whole.','If a pizza is cut into 4 equal pieces, each piece is one quarter.'],['➕','Adding fractions','When denominators are the same, add the top numbers and keep the bottom number.'],['✅','Quick check','If you eat 2 out of 4 slices, what fraction of the pizza did you eat?']]},
 {title:'Photosynthesis',emoji:'🌱',subject:'Science',slides:[['🌞','Plants need light','Plants use sunlight as energy.'],['💧','Water and carbon dioxide','Roots take in water and leaves take in carbon dioxide.'],['🌿','Plants make food','The plant uses light energy to make glucose and releases oxygen.']]},
 {title:'Essay structure',emoji:'📝',subject:'English',slides:[['📝','Plan before you write','Know your main idea and three supporting points.'],['🧱','Build paragraphs','Use a topic sentence, evidence or example, and explanation.'],['🎯','Strong conclusion','Summarise your argument without simply repeating every sentence.']]},
 {title:'Tourism concepts',emoji:'🌍',subject:'Tourism',slides:[['🌍','Domestic tourism','Travel within your own country.'],['✈️','International tourism','Travel from one country to another.'],['🧠','Exam tip','Learn the definition, then connect it to a real example.']]}
];
const state=JSON.parse(localStorage.getItem('plcState')||'null')||{name:'Learner',grade:6,progress:78,lessons:3,reading:2,practice:4,streak:4,minutes:320,strengths:['Reading','Science','Curiosity','Problem solving'],needs:['Maths','Writing','Time management','Exam technique'],activities:[]};
function save(){localStorage.setItem('plcState',JSON.stringify(state));renderState()}
function bump(type,label){if(type==='lesson')state.lessons++;if(type==='reading')state.reading++;if(type==='practice')state.practice++;state.progress=Math.min(100,state.progress+2);state.minutes+=10;state.activities.unshift({label,date:new Date().toISOString()});save()}
function switchView(id){document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('#roleSwitch button').forEach(b=>b.classList.toggle('active',b.dataset.view===id));window.scrollTo({top:document.getElementById(id).offsetTop-70,behavior:'smooth'});}
