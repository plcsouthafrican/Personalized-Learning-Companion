function nextSlide(){if(currentSlide<videoLessons[currentLesson].slides.length-1){currentSlide++;renderSlide()}else{bump('lesson',videoLessons[currentLesson].title);toast('Lesson completed — great work!');closeModal('lessonModal')}}function prevSlide(){if(currentSlide>0){currentSlide--;renderSlide()}}function speakCurrentSlide(){const s=videoLessons[currentLesson].slides[currentSlide];speakText(s[1]+'. '+s[2])}
