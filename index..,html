.modal{position:fixed;inset:0;background:#14213daa;display:none;align-items:center;justify-content:center;z-index:100;padding:16px}.modal.open{display:flex}.modalbox{width:min(760px,100%);max-height:90vh;overflow:auto;background:white;border-radius:26px;padding:20px;box-shadow:0 24px 80px #0005}.modal-head{display:flex;justify-content:space-between;align-items:center;gap:10px}.modal-head h3{margin:0}.x{border:0;width:38px;height:38px;border-radius:50%;background:#f1f4f8;font-weight:1000}.lesson-slide{min-height:250px;border-radius:22px;background:linear-gradient(135deg,#eef8ff,#f7f1ff);padding:24px;display:grid;place-items:center;text-align:center}.lesson-slide .emoji{font-size:64px}.toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%) translateY(30px);background:#17335d;color:white;padding:12px 15px;border-radius:14px;font-size:12px;font-weight:800;opacity:0;pointer-events:none;transition:.25s;z-index:110}.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}.footer{max-width:1440px;margin:18px auto 35px;padding:18px;text-align:center;color:#60718b;font-size:12px}.footer b{color:var(--ink)}
.mobile-tabs{display:none}
@media(max-width:980px){.hero{grid-template-columns:1fr}.feature-row{grid-template-columns:repeat(3,1fr)}.dash-body{grid-template-columns:1fr}.side{display:none}.grid-4{grid-template-columns:repeat(2,1fr)}.grid-3{grid-template-columns:1fr 1fr}.subject-grid{grid-template-columns:repeat(3,1fr)}.mobile-tabs{display:flex;gap:7px;overflow:auto;padding:0 0 12px}.mobile-tabs button{border:0;background:white;border:1px solid var(--line);padding:9px 11px;border-radius:999px;white-space:nowrap;font-size:11px;font-weight:900}.mobile-tabs button.active{background:var(--ink);color:white}.role-switch{max-width:62vw}.brandcopy{display:none}}
@media(max-width:620px){.shell{padding:10px}.topbar-in{padding:8px 10px}.brandmark{font-size:29px}.role-switch button{padding:8px 10px;font-size:10px}.hero{padding:18px;border-radius:24px}.hero h1{font-size:37px}.hero p{font-size:14px}.feature-row{grid-template-columns:repeat(2,1fr)}.dashboard{border-radius:24px}.dash-head{padding:15px}.dash-head h2{font-size:21px}.main{padding:12px}.grid-4,.grid-3,.grid-2,.formrow{grid-template-columns:1fr}.subject-grid{grid-template-columns:repeat(2,1fr)}.welcome{align-items:flex-start}.mascot{font-size:40px}.reading-sentence{font-size:18px}.card{border-radius:17px}.hero-actions .btn{width:100%}}
