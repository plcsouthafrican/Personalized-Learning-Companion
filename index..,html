document.querySelectorAll('[data-nav] button').forEach(b=>b.onclick=()=>showPanel(b.closest('[data-nav]').dataset.nav,b.dataset.panel));
function fillSubjects(){const html=subjects.map(s=>`<button class="subject" onclick="selectSubject('${s[1]}')"><span>${s[0]}</span>${s[1]}</button>`).join('');['youngSubjects','olderSubjects','olderSubjectsFull'].forEach(id=>document.getElementById(id).innerHTML=html);['youngAskSubject','olderAskSubject'].forEach(id=>document.getElementById(id).innerHTML=subjects.slice(0,-1).map(s=>`<option>${s[1]}</option>`).join(''));}
