function startVoice(target){const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){toast('Voice input is not supported by this browser. You can type instead.');return}const r=new SR();r.lang='en-ZA';r.interimResults=false;r.onstart=()=>toast('Listening… speak now');r.onresult=e=>{document.getElementById(target).value=e.results[0][0].transcript;toast('I heard you ✓')};r.onerror=()=>toast('I could not hear clearly. Try again or type your question.');r.start()}
function tutorResponse(q,subject,level){const x=q.toLowerCase();let body='';if(x.includes('fraction'))body='A fraction shows parts of a whole. Think of a pizza cut into equal pieces. The bottom number tells us how many equal pieces there are, and the top number tells us how many pieces we have. Example: 3/4 means 3 pieces out of 4 equal pieces.';else if(x.includes('photosynthesis')||x.includes('plant'))body='Photosynthesis is how green plants make their own food. The plant takes in water through its roots, carbon dioxide through its leaves, and uses sunlight as energy. It makes glucose for food and releases oxygen.';else if(x.includes('tourism'))body='Start by identifying the tourism term in the question. Domestic tourism means travelling within your own country; international tourism means travelling to another country. Then connect the definition to a real example.';else if(x.includes('essay')||x.includes('writing'))body='Start with a simple plan: introduction, 2–3 body paragraphs, and conclusion. Each body paragraph should have one main point, an example or evidence, and an explanation of why it matters.';else if(x.includes('quadratic')||x.includes('algebra'))body='For an algebra problem, first identify what the unknown is. Then simplify each side, move like terms together, and undo operations one step at a time. For a quadratic, first put it in the form ax² + bx + c = 0, then choose a method such as factoring or the quadratic formula.';else body=`Let’s work on this ${subject} question together. First, tell me what part feels confusing. Then we’ll break the problem into small steps, look at one example, and finish with a quick check so you know you understand it.`;return `<b>PLC explanation:</b><br>${body}<br><br><b>Quick check:</b> Can you explain the main idea back to me in your own words?`}
function answerQuestion(which){const q=document.getElementById(which+'AskInput').value.trim(),sub=document.getElementById(which+'AskSubject').value,out=document.getElementById(which+'Reply');if(!q){toast('Type or speak a question first');return}out.innerHTML=tutorResponse(q,sub,which);out.classList.remove('hide');bump('practice','Asked PLC about '+sub)}
function previewPhoto(input,id){const f=input.files&&input.files[0];if(!f)return;const r=new FileReader();r.onload=e=>document.getElementById(id).innerHTML=`<img src="${e.target.result}" alt="Homework photo preview">`;r.readAsDataURL(f);toast('Photo added ✓')}
function homeworkHelp(which){const q=document.getElementById(which+'HwInput').value.trim()||'this homework photo';const out=document.getElementById(which+'HwReply');out.innerHTML=`<b>Let’s solve it together:</b><br>1. Read the question and identify what it is asking.<br>2. Write down the information you already know.<br>3. Choose the rule, formula or idea that fits.<br>4. Work through one small step at a time.<br>5. Check whether the final answer makes sense.<br><br><b>Your note:</b> ${escapeHtml(q)}<br><br><span class="tiny muted">This build demonstrates the full PLC experience. A secure AI backend can be connected next for real photo-reading and unlimited subject answers.</span>`;out.classList.remove('hide');bump('practice','Homework help')}
const readingSamples=['The bright sun makes everything look beautiful.','Learning a little every day helps us grow.','The curious learner asked a thoughtful question.','We can practise difficult words one small step at a time.'];let rs=0;function newReadingSentence(){rs=(rs+1)%readingSamples.length;document.getElementById('readingSentence').innerHTML=readingSamples[rs].replace(/\b(beautiful|Learning|curious|practise)\b/i,'<mark>$1</mark>');document.getElementById('readingFeedback').textContent='Ready when you are. Tap “Read aloud”.'}
function startReadingCoach(){const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){document.getElementById('readingFeedback').innerHTML='Voice reading is not supported in this browser. Use <b>Listen first</b>, then practise aloud.';return}const expected=document.getElementById('readingSentence').innerText.toLowerCase().replace(/[^a-z ]/g,'').trim();const r=new SR();r.lang='en-ZA';r.interimResults=false;r.onstart=()=>document.getElementById('readingFeedback').textContent='Listening… read the sentence aloud.';r.onresult=e=>{const heard=e.results[0][0].transcript.toLowerCase().replace(/[^a-z ]/g,'').trim();const ew=expected.split(/\s+/),hw=heard.split(/\s+/);const hits=ew.filter(w=>hw.includes(w)).length,score=Math.round(hits/ew.length*100);const msg=score>85?'Wonderful reading! Great pronunciation. 🌟':score>65?'Good try! Let’s practise the tricky words once more. 💛':'Nice effort. Listen once, then try the sentence again slowly. 🌱';document.getElementById('readingFeedback').innerHTML=`${msg}<br><span class="tiny">PLC heard: “${escapeHtml(e.results[0][0].transcript)}” • Match ${score}%</span>`;bump('reading','Reading Coach')};r.onerror=()=>document.getElementById('readingFeedback').textContent='I could not hear clearly. Try again in a quieter place.';r.start()}
function startPractice(){const q=prompt('Quick practice: What is 1/2 + 1/4 ?');if(q===null)return;if(q.replace(/\s/g,'')==='3/4'){toast('Correct! 1/2 = 2/4, so 2/4 + 1/4 = 3/4 ✓');bump('practice','Quick Maths practice')}else toast('Good try. Hint: change 1/2 to 2/4 first.')}
function startExamPlan(){const s=prompt('Which subject are you preparing for?','Maths');if(!s)return;alert(`PLC exam plan for ${s}:\n\n1. List the topics in the test.\n2. Mark each topic: confident / needs practice / difficult.\n3. Start with one difficult topic.\n4. Watch a short explanation.\n5. Do 3 practice questions.\n6. Review mistakes before moving on.`);bump('practice','Exam plan for '+s)}
function addStudyGoal(){const g=prompt('Add a study goal:','Revise one difficult topic');if(!g)return;const goals=JSON.parse(localStorage.getItem('plcGoals')||'[]');goals.push(g);localStorage.setItem('plcGoals',JSON.stringify(goals));renderStudyPlan();toast('Study goal added')}
function renderStudyPlan(){const base=['Maths — practise questions','English — essay draft','Science — revision','History — read notes'],extra=JSON.parse(localStorage.getItem('plcGoals')||'[]');document.getElementById('studyPlan').innerHTML=base.concat(extra).map((g,i)=>`<div class="list-item"><input type="checkbox" ${i<2?'checked':''} onchange="if(this.checked){bump('practice','Study goal completed')}"/><div class="grow"><b>${escapeHtml(g)}</b></div></div>`).join('')}
function struggleHelp(){const q=document.getElementById('struggleInput').value.trim(),out=document.getElementById('struggleReply');if(!q){toast('Tell PLC which subject or topic is difficult');return}out.innerHTML=`<b>Your support plan:</b><br>1. Start with a 10–15 minute explanation of <b>${escapeHtml(q)}</b>.<br>2. Write down 3 key ideas in your own words.<br>3. Do one easy example with PLC.<br>4. Try 3 practice questions without help.<br>5. Review any mistake and repeat only the part that was difficult.`;out.classList.remove('hide')}
function renderList(id,items,bad=false){document.getElementById(id).innerHTML=items.map(x=>`<div class="list-item"><span class="dot ${bad?'bad':''}"></span><b>${escapeHtml(x)}</b></div>`).join('')}
function renderState(){const g=state.grade;document.getElementById('youngNameSide').textContent='Hi, '+state.name+'!';document.getElementById('youngGradeSide').textContent='Grade '+Math.min(7,Math.max(4,g));document.getElementById('olderNameSide').textContent='Hi, '+state.name+'!';document.getElementById('olderGradeSide').textContent='Grade '+Math.max(8,g);document.getElementById('youngPct').textContent=state.progress+'%';document.getElementById('youngProgressBar').style.width=state.progress+'%';document.getElementById('youngLessons').textContent=state.lessons;document.getElementById('youngReadingCount').textContent=state.reading;document.getElementById('youngStreak').textContent=state.streak;document.getElementById('olderLessons').textContent=state.lessons+2;document.getElementById('olderPractice').textContent=state.practice;document.getElementById('olderStreak').textContent=Math.max(6,state.streak);document.getElementById('olderOverall').textContent=state.progress+'% overall';document.getElementById('parentPct').textContent=state.progress+'%';document.getElementById('parentTime').textContent=Math.floor(state.minutes/60)+'h '+(state.minutes%60)+'m';document.getElementById('parentStreak').textContent=state.streak+' days';document.getElementById('parentChildLabel').textContent=state.name+' • Grade '+state.grade;document.getElementById('parentWelcome').textContent=state.name+' is making progress 🌱';renderList('youngStrengths',state.strengths);renderList('youngNeeds',state.needs,true);renderList('olderStrengths',state.strengths);renderList('olderNeeds',state.needs,true);renderList('parentStrengths',state.strengths);renderList('parentNeeds',state.needs,true)}
function escapeHtml(s){return String(s).replace(/[&<>'"]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[m]))}
function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');clearTimeout(window.__to);window.__to=setTimeout(()=>t.classList.remove('show'),2600)}
function editProfile(){const name=prompt('Learner’s first name:',state.name);if(name&&name.trim())state.name=name.trim();const grade=prompt('Grade (4–12):',String(state.grade));const n=Number(grade);if(n>=4&&n<=12)state.grade=n;save();if(state.grade>=8)switchView('older');else switchView('younger');}
fillSubjects();renderVideos();renderStudyPlan();renderState();
window.addEventListener('click',e=>{if(e.target.classList.contains('modal'))e.target.classList.remove('open')});
</script>
</body>
</html>
