.older .dash-head{background:linear-gradient(135deg,#426cdf,#6d5ce8);color:white}.older .main{background:linear-gradient(180deg,#f5f8ff,#fff)}.older .welcome{background:linear-gradient(135deg,#eaf4ff,#f3efff)}
.parent .dash-head{background:linear-gradient(135deg,#1e9f78,#55c9a0);color:white}.parent .main{background:#f7fffb}.parent .welcome{background:linear-gradient(135deg,#e4faf1,#f4fff8)}
