.section{display:none;margin-top:18px}.section.active{display:block}.dashboard{border-radius:32px;box-shadow:var(--shadow);border:1px solid var(--line);overflow:hidden;background:white}.dash-head{padding:18px 20px;display:flex;align-items:center;justify-content:space-between;gap:10px}.dash-head h2{margin:0;font-size:26px}.dash-head p{margin:3px 0 0;font-size:12px;opacity:.75}.dash-body{display:grid;grid-template-columns:210px 1fr;min-height:720px}.side{padding:14px;border-right:1px solid var(--line);background:rgba(255,255,255,.85)}.profile-mini{display:flex;gap:10px;align-items:center;padding:10px;border-radius:16px;background:white;border:1px solid var(--line);margin-bottom:12px}.avatar{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#ffd9a5,#ffeef1);font-size:24px}.profile-mini b{display:block;font-size:12px}.profile-mini small{font-size:10px;color:var(--muted)}.nav{display:grid;gap:5px}.nav button{border:0;background:transparent;border-radius:12px;padding:11px 10px;text-align:left;color:#52617a;font-size:12px;font-weight:800}.nav button:hover,.nav button.active{background:#eef4ff;color:#1c4ea1}.main{padding:18px;background:#fbfdff}.welcome{border-radius:24px;padding:18px;margin-bottom:14px;display:flex;justify-content:space-between;align-items:center;gap:15px}.welcome h3{margin:0 0 5px;font-size:22px}.welcome p{margin:0;color:#61708a;font-size:13px}.mascot{font-size:52px}.grid{display:grid;gap:12px}.grid-4{grid-template-columns:repeat(4,1fr)}.grid-3{grid-template-columns:repeat(3,1fr)}.grid-2{grid-template-columns:repeat(2,1fr)}.card{background:#fff;border:1px solid var(--line);border-radius:20px;padding:15px;box-shadow:0 8px 20px rgba(34,66,120,.05)}.card h3,.card h4{margin:0 0 8px}.card p{margin:4px 0;color:#66758f;font-size:12px;line-height:1.45}.action-card{min-height:115px;display:flex;flex-direction:column;justify-content:space-between}.action-card .bigicon{font-size:31px}.action-card button{align-self:flex-start}.mini-btn{border:0;border-radius:10px;padding:8px 10px;font-size:11px;font-weight:900;background:#eef4ff;color:#245ab7}.progressbar{height:9px;background:#edf1f6;border-radius:999px;overflow:hidden}.progressbar span{height:100%;display:block;border-radius:999px;background:linear-gradient(90deg,#4c8df6,#29c4b5)}.chart{display:flex;align-items:flex-end;gap:8px;height:120px;padding-top:10px}.bar{flex:1;min-width:24px;background:linear-gradient(180deg,#4ca3ff,#30c8b2);border-radius:9px 9px 3px 3px;position:relative}.bar small{position:absolute;top:-20px;width:100%;text-align:center;font-weight:900;font-size:9px}.labels{display:flex;gap:8px}.labels span{flex:1;text-align:center;font-size:9px;color:#72809b}.statline{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:8px 0}.stat{font-size:28px;font-weight:1000}.chip{display:inline-flex;align-items:center;gap:5px;padding:6px 9px;border-radius:999px;background:#eef8f4;color:#26815b;font-size:10px;font-weight:900}.list{display:grid;gap:8px}.list-item{display:flex;align-items:center;gap:9px;padding:9px 0;border-bottom:1px dashed #e7ecf2}.list-item:last-child{border:0}.dot{width:9px;height:9px;border-radius:50%;background:#41bd7d}.dot.bad{background:#ff6878}.grow{flex:1}.pill{display:inline-flex;padding:5px 8px;border-radius:999px;background:#f3f6fb;color:#61708a;font-size:9px;font-weight:900}.subject-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:9px}.subject{padding:12px 8px;border-radius:16px;background:#f8fbff;border:1px solid var(--line);text-align:center;font-weight:900;font-size:11px}.subject span{display:block;font-size:24px;margin-bottom:5px}.subject:hover{transform:translateY(-2px)}.input,.select,.textarea{width:100%;border:1px solid #d9e1ec;background:white;border-radius:14px;padding:12px;outline:none;color:var(--ink)}.textarea{min-height:100px;resize:vertical}.input:focus,.select:focus,.textarea:focus{border-color:#70a4f7;box-shadow:0 0 0 3px #4c8df61c}.formrow{display:grid;grid-template-columns:1fr 1fr;gap:10px}.reply{margin-top:10px;background:#f0fbf9;border:1px solid #c6eee9;border-radius:15px;padding:12px;font-size:13px;line-height:1.5}.teacher-screen{aspect-ratio:16/8;border-radius:18px;background:linear-gradient(135deg,#1d2f57,#2a5ba2);color:white;padding:18px;display:flex;align-items:center;justify-content:center;text-align:center;position:relative;overflow:hidden}.teacher-screen:before{content:"";position:absolute;width:220px;height:220px;border-radius:50%;background:#ffffff12;right:-40px;top:-70px}.teacher-avatar{font-size:54px}.video-controls{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.photo-preview{margin-top:10px;border-radius:16px;overflow:hidden;background:#f1f4f8;min-height:80px;display:grid;place-items:center}.photo-preview img{max-width:100%;max-height:260px;display:block}.reading-sentence{font-size:22px;line-height:1.7;font-weight:900;background:#fff9d9;border:1px solid #ffe996;padding:16px;border-radius:17px}.reading-sentence mark{background:#ffdf58;border-radius:5px;padding:1px 4px}.feedback{margin-top:10px;padding:11px;border-radius:14px;background:#eefaf4;color:#28765a;font-weight:800;font-size:12px}.muted{color:var(--muted)}.tiny{font-size:10px}.mt{margin-top:12px}.section-title{margin:0 0 5px}.section-sub{margin:0 0 14px;color:var(--muted);font-size:13px}
